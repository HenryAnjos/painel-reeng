# Supabase (Project Settings > API). A service_role fica so no servidor.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Segredo que assina as sessoes. String longa e aleatoria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Endereco publico do motor (aparece na tela de Integracao)
MOTOR_URL=https://seu-motor.up.railway.app

# Segredo compartilhado com o motor (mesmo valor la), usado para conectar
# contas do Telegram pelo painel. Gere como o AUTH_SECRET.
PAINEL_TOKEN=

# false = so entra quem for convidado (cadastro publico fechado)
CADASTRO_ABERTO=true
